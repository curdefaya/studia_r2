\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Skanowanie podsieci \texttt  {149.156.115.0/24}. U góry widzimy podsumowanie wcześniejszego wykrywania hostów: 22 adresy aktywne z 256. Niżej uruchomiono listowanie \texttt  {-sL} i zapis wyniku do \texttt  {c\_115sL.txt}; wypisane nazwy, np. \texttt  {emi.wibro.agh.edu.pl}, pochodzą z mapowania DNS.}}{8}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Dwa uzupełniające się wyniki dla \texttt  {149.156.116.0/24}. Listowanie DNS kończy się komunikatem \texttt  {0 hosts up}, co nie oznacza, że adresy są nieaktywne. Następne polecenie \texttt  {-sn} wykrywa 13 odpowiadających hostów; widoczne nazwy to m.in. \texttt  {dzk.ceramika.agh.edu.pl} i \texttt  {a3-09.gorn.agh.edu.pl}.}}{9}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Powtórne wyświetlenie wykrywania aktywnych hostów i listowania DNS w podsieci \texttt  {149.156.116.0/24}. Na dole widoczna jest nieudana próba użycia opcji \texttt  {-iL} z adresem IP zamiast ścieżki do pliku listy. Komunikat o błędzie otwarcia pliku oznacza, że ta próba nie jest wynikiem skanowania hosta i nie została włączona do opracowania.}}{9}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Skan SYN listy zapisanej w \texttt  {lista\_skan\_sS.txt}. Najpierw pokazano wynik dla \texttt  {149.156.116.12}: otwarte porty 21/tcp (FTP) i 80/tcp (HTTP). Następnie widoczne jest uruchomienie skanowania listy; na kolejnych hostach obserwujemy m.in. porty filtrowane na \texttt  {149.156.116.129}. Pełne wyniki wszystkich ośmiu hostów znajdują się w tabeli opracowanej z \texttt  {skan\_listy\_8el.txt}.}}{10}{figure.7}\protected@file@percent }
